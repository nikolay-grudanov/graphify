Table "kful_opportunity_products" {
  "object_id" varchar(36) [not null, note: 'Уникальный идентификатор']
  "kful_opportunity_id" varchar(36) [not null, note: 'Уникальный идентификатор сделки кредитной фабрики']
  "name" varchar(256) [note: 'Наименование продукта']
  "ckpit_id" varchar(64) [note: 'Уникальный идентификатор центрального каталога продуктов']
  "lock" int8 [default: 0, note: 'Параметр блокировки таблицы']
  "amount" numeric [note: 'Сумма']
  "currency_code" varchar(64) [note: 'Код валюты']
  "old_period" int4 [note: 'Период старый']
  "period" numeric [note: 'Период']


  Indexes {
    object_id [pk, name: "PK_KFUL_OPPORTUNITY_PRODUCTS#OBJECT_ID"]
  }
  Note: 'Продукты сделки кредитной фабрики'
}


Table "kful_opportunity_team_members" {
  "object_id" varchar(36) [not null, note: 'Уникальный идентификатор']
  "kful_opportunity_id" varchar(36) [not null, note: 'Уникальный идентификатор сделки кредитной фабрики']
  "personal_number" varchar(64) [not null, note: 'Табельный номер члена команды']
  "role_code" varchar(64) [note: 'Код роли члена команды']
  "lock" int8 [default: 0, note: 'Параметр блокировки таблицы']
  "kful_role_code" varchar [note: 'Код роли в кредитной фабрике']


  Indexes {
    object_id [pk, name: "KFUL_OPPORTUNITY_TEAM_MEMBERS#OBJECT_ID"]
  }
  Note: 'Команда сделки кредитной фабрики'
}


Table "kful_deal_types" {
  "code" varchar(64) [not null, note: 'Код']
  "name" varchar [not null, note: 'Наименование']


  Indexes {
    code [pk, name: "PK_KFUL_DEAL_TYPES#CODE"]
  }
  Note: 'Справочник типов сделок кредитной фабрики юридических лиц'
}


