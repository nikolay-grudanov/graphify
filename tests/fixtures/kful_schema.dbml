Table "kful_opportunities" {
  "object_id" varchar(36) [not null, note: 'Уникальный идентификатор']
  "pprb_id" varchar [not null, note: 'Уникальный идентификатор платформы поддержки развития бизнеса']
  "crm_id" varchar [note: 'Уникальный идентификатор ЦРМ']
  "receipt_date" timestamp [note: 'Дата получения сделки']
  "kful_create_date" timestamp [note: 'Дата изменения сделки кредитной фабрикой']
  "shareholder_risk_criteria_type_code" varchar(64) [note: 'Критерий акционерного риска']
  "shareholder_risk_criteria_update_date" timestamp [note: 'Дата обновления акционерного риска']
  "processing_state_type_code" varchar(64) [not null, note: 'Статус обработки сделки']
  "retirement_reason_type_code" varchar(64) [note: 'Причина выбытия сделки']
  "retirement_date" timestamp [note: 'Дата выбытия сделки']
  "retirement_comment" text [note: 'Комментарий к причине выбытия']
  "opportunity_object_id" varchar(36) [note: 'Уникальный идентификатор сделки департамента инвестиционной деятельности']
  "opportunity_id" varchar(36) [note: 'Идентификатор сделки департамента инвестиционной деятельности']
  "party_object_id" varchar(256) [note: 'Идентификатор клиента сделки']
  "amount" numeric [note: 'Общий объём сделки']
  "did_products_amount" numeric [note: 'Общий объём сделки по продуктам департамента инвестиционной деятельности']
  "branch_code" varchar(64) [note: 'Код территориального банка']
  "response_kful_date" timestamp [note: 'Дата отправки ответа по сделке в кредитную фабрику']
  "lock" int8 [default: 0, note: 'Параметр блокировки таблицы']
  "kful_description" varchar(1024) [note: 'Описание сделки кредитной фабрики']
  "route_date" timestamp [note: 'Дата маршрутизации']
  "kful_update_date" timestamp [note: 'Дата обновления информации кредитной фабрикой']
  "currency_code" varchar(64) [note: 'Код валюты']
  "pegasus_shareholder_risk" bool [note: 'Акционерный риск из системы пегас']
  "kful_state_type_code" varchar(64) [note: 'Код статуса сделки кредитной фабрики']
  "route_comment" text [note: 'Комментарий маршрутизации']
  "route_error" bool [note: 'Признак ошибки маршрутизации']
  "desk_to_route_code" varchar(64) [note: 'Код деска маршрутизации']
  "route_time" timestamp [note: 'Время маршрутизации']
  "route_count" int4 [default: 0, note: 'Количество попыток маршрутизации']
  "migration_status_idp" varchar(64) [default: `'NEED_INFO'::charactervarying`, note: 'Статус миграции анализатора']
  "desks_updated" bool [default: false, note: 'Признак обновления деска']
  "kful_opportunity_folder_object_id" varchar(36) [note: 'Код папки сделки']
  "idp_shareholder_risk_code" varchar(256) [default: `'UNKNOWN'::charactervarying`, note: 'Код акционерного риска выявленнго анализатором документов']
  "idp_checking_document_date" timestamp [note: 'Дата проверки документов анализатором']
  "document_add_date" timestamp [note: 'Дата добавления документа']
  "idp_last_answer_date" timestamp [note: 'Дата последнего получения ответа анализатора']
  "route_controller_number" varchar [note: 'Табельный номер контролера, который выполнил маршрутизацию сделки']
  "version" int8 [note: 'Номер версии']
  "ai_agent_processed" bool [default: false, note: 'Признак обработки агентом']
  "ai_agent_shareholder_risk_code" varchar [default: `'UNKNOWN'::charactervarying`, note: 'Код акционерного риска выявленнго агентом', ref: > idp_shareholder_risk_types.code]
  "ai_agent_processed_date" timestamp [note: 'Дата проверки агенктом']
  "ai_agent_comment " varchar [note: 'Комментарий агента по принятию решения']
  "has_new_product" bool [note: 'Признак наличия нового продукта в сделке', not null]
  "kful_deal_type_code" varchar [note: 'Тип сделки КФЮЛ', ref: > kful_deal_types.code, not null]



  Indexes {
    object_id [pk, name: "PK_KFUL_OPPORTUNITIES#OBJECT_ID"]
    pprb_id [unique, name: "kful_opportunities_pprb_id_key"]
    pprb_id [type: btree, name: "INDEX_KFUL_OPPORTUNITIES#PPRB_ID"]
    processing_state_type_code [type: btree, name: "INDEX_KFUL_OPPORTUNITIES#PROCESSING_STATE_TYPE_CODE"]
  }
  Note: 'Сделка кредитной фабрики юридических лиц'
}


