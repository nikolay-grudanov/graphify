  "idp_question" varchar [note: 'Формулировка вопроса анализатора']
  "idp_answer" varchar [note: 'Ответ анализатора']
  "idp_date_time_answer" timestamp [note: 'Дата получения ответа анализатора']
  "idp_presence_arisk" bool [note: 'Наличие критерия акционерного риска']


  Indexes {
    object_id [pk, name: "PK_IDP_ANSWERS#OBJECT_ID"]
    document_id [type: btree, name: "IDP_ANSWERS#DOCUMENT_ID"]
  }
  Note: 'Ответы анализатора документов'
}


Table "idp_arisk_condition_answer" {
  "object_id" varchar [not null, note: 'Уникальный идентификатор']
  "document_type_code" varchar(255) [not null, note: 'Код типа документа']
  "idp_name_question" varchar [note: 'Номер вопроса анализатора']
  "idp_arisk_target_indicator" varchar [note: 'Ожидаемые ответы']
  "idp_arisk_condition" varchar [note: 'Критерий оценки']
  "idp_arisk_condition_consider" bool [note: 'Признак существенности ответа']
  "expected_response_type" varchar [note: 'Ожидаемый формат ответа']
  "desks_codes" varchar [note: 'Коды десков для оценки существенности ответа']


  Indexes {
    object_id [pk, name: "PK_IDP_ARISK_CONDITION_ANSWER#OBJECT_ID"]
    (document_type_code, idp_name_question) [unique, name: "idp_arisk_condition_answer_unique_constraint_on_2_fields"]
    (document_type_code, idp_name_question) [type: btree, name: "IDP_ARISK_CONDITION_ANSWER#DOCUMENT_TYPE_CODE_AND_IDP_NAME_QUESTION"]
  }
  Note: 'Критерии оценки ответов анализатора документов'
}


