Table "databasechangelog" {
  "id" varchar(255) [not null, note: 'Уникальный идентификатор']
  "author" varchar(255) [not null, note: 'Автор']
  "filename" varchar(255) [not null, note: 'Название файла миграции']
  "dateexecuted" timestamp [not null, note: 'Дата установки миграции']
  "orderexecuted" int4 [not null, note: 'Порядок установки миграци']
  "exectype" varchar(10) [not null, note: 'Признак установки миграции']
  "md5sum" varchar(35) [note: 'Хеш сумма']
  "description" varchar(255) [note: 'Описание']
  "comments" varchar(255) [note: 'Коментарии']
  "tag" varchar(255) [note: 'Техничесское поле']
  "liquibase" varchar(20) [note: 'Версия библиотеки liquibase']
  "contexts" varchar(255) [note: 'Контекс миграции']
  "labels" varchar(255) [note: 'Метки миграции']
  "deployment_id" varchar(10) [note: 'Уникальный идентификатор установки']
  Note: 'Таблица описания миграций'
}


